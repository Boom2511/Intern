# ===============================================
# LINE API RATE LIMITING & QUOTA OPTIMIZATION
# ===============================================
# IMPORTANT: LINE counts ALL API calls (including 429 failures) toward monthly quota
# These settings are optimized to minimize quota usage

# Max retry attempts (OPTIMIZED: reduced from 4 to 1)
# Recommended: 1 (prevents wasting quota on failed retries)
API_MAX_RETRIES=1

# Random jitter for retry delays (milliseconds)
API_RETRY_JITTER_MS=200

# Max concurrent requests (OPTIMIZED: reduced from 5 to 2)
# Prevents burst sending that triggers rate limits
LINE_RATE_LIMIT_MAX_CONCURRENCY=2

# Min time between requests (OPTIMIZED: increased from 200ms to 500ms)
# 500ms = 2 requests/second maximum
LINE_RATE_LIMIT_MIN_TIME_MS=500

# Advanced Rate Limiting (Optional - Token Bucket)
# LINE_RATE_LIMIT_RESERVOIR=50
# LINE_RATE_LIMIT_RESERVOIR_REFRESH=10
# LINE_RATE_LIMIT_RESERVOIR_INTERVAL_MS=1000

# ===============================================
# LINE EMERGENCY CONTROLS
# ===============================================
# Emergency kill switch - Set to 'true' to disable ALL LINE notifications
DISABLE_LINE_NOTIFICATIONS=false

