# Database
DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN="your-line-channel-access-token"
LINE_DEFAULT_GROUP_ID="your-default-group-id"

# LINE API Rate Limiting Configuration
# Prevents HTTP 429 (Too Many Requests) errors
# See docs/RATE_LIMITING.md for detailed configuration guide

# Basic Rate Limiting (Required)
LINE_RATE_LIMIT_MAX_CONCURRENCY=5        # Max concurrent requests (default: 5)
LINE_RATE_LIMIT_MIN_TIME_MS=200          # Min time between requests in ms (default: 200)

# Advanced Rate Limiting (Optional - Token Bucket)
# Uncomment and configure for burst control
# LINE_RATE_LIMIT_RESERVOIR=50           # Max tokens in bucket
# LINE_RATE_LIMIT_RESERVOIR_REFRESH=10   # Tokens added per interval
# LINE_RATE_LIMIT_RESERVOIR_INTERVAL_MS=1000  # Refill interval in ms

# Retry Configuration
API_MAX_RETRIES=4                        # Max retry attempts for failed requests (default: 4)
API_RETRY_JITTER_MS=200                  # Random jitter for retry delays in ms (default: 200)

# Metrics & Monitoring
# Optional: Add Bearer token authentication for /api/metrics endpoint
# METRICS_SECRET="your-metrics-secret-token"

# Cron Job Security
# Optional: Add Bearer token authentication for /api/cron/* endpoints
# CRON_SECRET="your-cron-secret-token"

# Storage Configuration (AWS S3 or Supabase)
# Choose one storage provider

# Option 1: AWS S3
# AWS_REGION="ap-southeast-1"
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_S3_BUCKET="your-bucket-name"

# Option 2: Supabase Storage
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_STORAGE_BUCKET="helpdesk-attachments"

# Application Settings
NEXT_PUBLIC_APP_NAME="Help Desk Thailand"
NEXT_PUBLIC_MAX_FILE_SIZE_MB=10

# ===================================================================
# RATE LIMIT CONFIGURATION PRESETS
# ===================================================================
# Choose a preset based on your LINE Messaging API tier
# Then uncomment and use the corresponding values above

# FREE TIER (~500 pushes/minute)
# LINE_RATE_LIMIT_MAX_CONCURRENCY=3
# LINE_RATE_LIMIT_MIN_TIME_MS=300
# LINE_RATE_LIMIT_RESERVOIR=50
# LINE_RATE_LIMIT_RESERVOIR_REFRESH=8
# LINE_RATE_LIMIT_RESERVOIR_INTERVAL_MS=1000

# BASIC TIER (~1000 pushes/minute) - DEFAULT
# LINE_RATE_LIMIT_MAX_CONCURRENCY=5
# LINE_RATE_LIMIT_MIN_TIME_MS=200
# LINE_RATE_LIMIT_RESERVOIR=100
# LINE_RATE_LIMIT_RESERVOIR_REFRESH=16
# LINE_RATE_LIMIT_RESERVOIR_INTERVAL_MS=1000

# STANDARD TIER (~2000 pushes/minute)
# LINE_RATE_LIMIT_MAX_CONCURRENCY=10
# LINE_RATE_LIMIT_MIN_TIME_MS=100
# LINE_RATE_LIMIT_RESERVOIR=200
# LINE_RATE_LIMIT_RESERVOIR_REFRESH=33
# LINE_RATE_LIMIT_RESERVOIR_INTERVAL_MS=1000

# ===================================================================
# MONITORING & ALERTS
# ===================================================================
# Access metrics at: GET /api/metrics
# - Prometheus format: /api/metrics
# - JSON format: /api/metrics?format=json
#
# Key metrics to monitor:
# - line_api_rate_limit_errors_total (Alert if > 5% in 5 minutes)
# - line_api_queue_length (Alert if > 50 for 2+ minutes)
# - line_api_retries_total (Alert if > 20% of total requests)
#
# See docs/RATE_LIMITING.md for complete monitoring guide
